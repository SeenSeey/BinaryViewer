#include <windows.h>

#define BINARY_VIEWER_VERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define BINARY_VIEWER_VERSION_STRING "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0\0"
#define IDI_BINARY_VIEWER 101

IDI_BINARY_VIEWER ICON "@BINARY_VIEWER_WINDOWS_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BINARY_VIEWER_VERSION
 PRODUCTVERSION BINARY_VIEWER_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Read-only binary file viewer\0"
            VALUE "FileVersion", BINARY_VIEWER_VERSION_STRING
            VALUE "InternalName", "BinaryViewer\0"
            VALUE "OriginalFilename", "BinaryViewer.exe\0"
            VALUE "ProductName", "Binary Viewer\0"
            VALUE "ProductVersion", BINARY_VIEWER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
